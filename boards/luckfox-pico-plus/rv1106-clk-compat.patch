--- a/drivers/clk/rockchip/clk-rv1103b.c
+++ b/drivers/clk/rockchip/clk-rv1103b.c
@@ -9,6 +9,7 @@
 #include <linux/of_address.h>
 #include <dt-bindings/clock/rockchip,rv1103b-cru.h>
 #include "clk.h"
+#include <linux/reset-controller.h>

 #define RV1103B_GRF_SOC_STATUS0		0x10
 #define RV1103B_FRAC_MAX_PRATE		1200000000
@@ -658,1 +659,54 @@ static void __init rv1103b_clk_init(struct device_node *np)
 CLK_OF_DECLARE(rv1103b_cru, "rockchip,rv1103b-cru", rv1103b_clk_init);
+
+/*
+ * Stub clock+reset provider for RV1106. U-Boot already configured all clocks;
+ * reprogramming the CRU with rv1103b register offsets corrupts the UART
+ * clock and hangs the CPU. Register dummy fixed-rate clocks and a no-op
+ * reset controller so peripheral drivers can probe without touching CRU regs.
+ */
+#define RV1106_MAX_CLKS 512
+
+static struct clk_hw *rv1106_clks[RV1106_MAX_CLKS];
+
+static struct clk_hw *rv1106_cru_hw_get(struct of_phandle_args *clkspec,
+					void *data)
+{
+	unsigned int id = clkspec->args[0];
+	char name[32];
+
+	if (id >= RV1106_MAX_CLKS)
+		return ERR_PTR(-EINVAL);
+
+	if (!rv1106_clks[id]) {
+		snprintf(name, sizeof(name), "rv1106-clk%u", id);
+		rv1106_clks[id] = clk_hw_register_fixed_rate(NULL, name, NULL,
+							     0, 100000000);
+	}
+	return rv1106_clks[id];
+}
+
+static int rv1106_reset_noop(struct reset_controller_dev *rcdev,
+			     unsigned long id)
+{
+	return 0;
+}
+
+static const struct reset_control_ops rv1106_reset_ops = {
+	.assert   = rv1106_reset_noop,
+	.deassert = rv1106_reset_noop,
+	.reset    = rv1106_reset_noop,
+};
+
+static struct reset_controller_dev rv1106_rcdev = {
+	.ops      = &rv1106_reset_ops,
+	.nr_resets = 0x80000,
+};
+
+static void __init rv1106_cru_init(struct device_node *np)
+{
+	of_clk_add_hw_provider(np, rv1106_cru_hw_get, NULL);
+	rv1106_rcdev.of_node = np;
+	reset_controller_register(&rv1106_rcdev);
+}
+
+CLK_OF_DECLARE(rv1106_cru, "rockchip,rv1106-cru", rv1106_cru_init);
