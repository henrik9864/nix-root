--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
@@ -1050,6 +1050,64 @@ static const struct rk_gmac_ops rv1108_ops = {
 	.supports_rmii = true,
 };

+/* RV1106: single GMAC with integrated 100M PHY (FePHY).
+ * GRF base 0xff000000; gmac_clk_con at GRF+0x060004,
+ * macphy_con0 at GRF+0x060028. */
+
+#define RV1106_GRF_GMAC_CLK_CON	0x060004
+#define RV1106_GRF_MACPHY_CON0		0x060028
+
+/* gmac_clk_con bit 0: 1 = RMII mode */
+#define RV1106_GMAC_CLK_RMII_MODE	GRF_BIT(0)
+/* gmac_clk_con bit 2: 0 = DIV20 (10 Mbps), 1 = DIV2 (100 Mbps) */
+#define RV1106_GMAC_CLK_RMII_DIV2	GRF_BIT(2)
+#define RV1106_GMAC_CLK_RMII_DIV20	GRF_CLR_BIT(2)
+
+static void rv1106_set_to_rmii(struct rk_priv_data *bsp_priv)
+{
+	regmap_write(bsp_priv->grf, RV1106_GRF_GMAC_CLK_CON,
+		     RV1106_GMAC_CLK_RMII_MODE);
+}
+
+static int rv1106_set_speed(struct rk_priv_data *bsp_priv,
+			    phy_interface_t interface, int speed)
+{
+	u32 val;
+
+	switch (speed) {
+	case 10:
+		val = RV1106_GMAC_CLK_RMII_DIV20;
+		break;
+	case 100:
+		val = RV1106_GMAC_CLK_RMII_DIV2;
+		break;
+	default:
+		dev_err(bsp_priv->dev, "unsupported speed %d\n", speed);
+		return -EINVAL;
+	}
+
+	return regmap_write(bsp_priv->grf, RV1106_GRF_GMAC_CLK_CON, val);
+}
+
+static void rv1106_integrated_phy_powerup(struct rk_priv_data *bsp_priv)
+{
+	rk_gmac_integrated_fephy_powerup(bsp_priv, RV1106_GRF_MACPHY_CON0);
+}
+
+static void rv1106_integrated_phy_powerdown(struct rk_priv_data *bsp_priv)
+{
+	rk_gmac_integrated_fephy_powerdown(bsp_priv, RV1106_GRF_MACPHY_CON0);
+}
+
+static const struct rk_gmac_ops rv1106_ops = {
+	.set_to_rmii			= rv1106_set_to_rmii,
+	.set_speed			= rv1106_set_speed,
+	.integrated_phy_powerup		= rv1106_integrated_phy_powerup,
+	.integrated_phy_powerdown	= rv1106_integrated_phy_powerdown,
+
+	.supports_rmii = true,
+};
+
 #define RV1126_GRF_GMAC_CON0		0X0070
 #define RV1126_GRF_GMAC_CON1		0X0074
 #define RV1126_GRF_GMAC_CON2		0X0078
@@ -1631,4 +1689,5 @@ static const struct of_device_id rk_gmac_dwmac_match[] = {
 	{ .compatible = "rockchip,rv1108-gmac", .data = &rv1108_ops },
+	{ .compatible = "rockchip,rv1106-gmac", .data = &rv1106_ops },
 	{ .compatible = "rockchip,rv1126-gmac", .data = &rv1126_ops },
 	{ }
 };
